{
  "name": "mirelth-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "办公智能体工作台：文档写作、数据分析、论文整理、科学研究与邮箱",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "start": "node scripts/start.ts",
    "test": "node --test scripts/regression.test.ts scripts/db.test.ts scripts/http-errors.test.ts scripts/platform.test.ts scripts/activity.test.ts scripts/pagination.test.ts scripts/office.test.ts scripts/roadmap.test.ts scripts/planner.test.ts scripts/planner-live.test.ts scripts/plugins.test.ts scripts/plugins-allowed.test.ts scripts/mcp-client.test.ts scripts/deck.test.ts scripts/vector-index.test.ts scripts/memory-layers.test.ts scripts/memory-episodic.test.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.15.4",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.0.200",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.5.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "uuid": "^14.0.3",
    "image-size": "^2.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
