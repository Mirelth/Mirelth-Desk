# ── 服务 ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173
# 生产环境必填；开发环境会自动生成并保存到 .data/secret.key
APP_SECRET=

# ── 本地账号 ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── AI 模型（OpenAI 兼容接口，留空则使用离线规则引擎）─────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── 语义检索（可选）─────────────────────────────────────
# 留空则检索走词法向量（离线可用）；填了才启用语义+词法混合检索。
# 需与 LLM_API_KEY 同时配置，且接口须兼容 OpenAI /embeddings。
LLM_EMBEDDING_MODEL=

# ── OCR（可选）──────────────────────────────────────────
# 语言包缓存目录：首次识别会自动下载到此目录，之后复用本地文件，无需手动准备。
OCR_LANG_PATH=.data/ocr
OCR_LANGS=chi_sim+eng
# 默认 true：缺包时自动下载。设为 false 则只用本地包、缺包报错（内网/无外网环境用）。
OCR_AUTO_DOWNLOAD=true
# 超时上限（毫秒）：防止 worker 静默挂起把请求悬死。本地加载 60s，首次下载 180s。
OCR_INIT_TIMEOUT_MS=60000
OCR_DOWNLOAD_TIMEOUT_MS=180000

# ── 浏览器自动化（可选，默认关闭）────────────────────────
# 开启前请知悉：调试端口能读取页面内容与 Cookie，等同高权限通道。
BROWSER_ENABLED=false
# 只允许回环地址，指向外部主机会被拒绝。
BROWSER_CDP_URL=http://127.0.0.1:9222
# 域名白名单，逗号分隔。留空 = 拒绝全部站点。例：example.com,docs.internal
BROWSER_ALLOWED_HOSTS=
BROWSER_MAX_STEPS=12
BROWSER_TIMEOUT_MS=30000
# 启动浏览器示例（Chrome 136+ 必须指定独立用户目录，否则调试端口不生效）：
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="E:\chrome-automation"
# 注意：独立目录是全新 profile，不会复用日常浏览器的登录态，首次需在其中登录目标站点。

# ── 数据库 ────────────────────────────────────────────
DATABASE_PATH=.data/mirelth.db
