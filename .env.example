# ── 服务 ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173
# 生产环境必填；开发环境会自动生成并保存到 .data/secret.key
APP_SECRET=

# ── 本地账号 ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── AI 模型（OpenAI 兼容接口，留空则使用离线规则引擎）─────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── 语义检索（可选）─────────────────────────────────────
# 留空则检索走词法向量（离线可用）；填了才启用语义+词法混合检索。
# 需与 LLM_API_KEY 同时配置，且接口须兼容 OpenAI /embeddings。
LLM_EMBEDDING_MODEL=

# ── 图片与扫描件识别（多模态模型）─────────────────────────
# 留空则沿用 LLM_MODEL；该模型必须支持图片输入。
# 例：gpt-4o、qwen-vl-max、glm-4v、gemini-2.0-flash
LLM_VISION_MODEL=
# 扫描件逐页转图识别的页数上限，防止一次任务超时与费用失控。
VISION_MAX_PAGES=10
# 渲染倍率：2 约等于 144dpi，兼顾清晰度与请求体积。
VISION_RENDER_SCALE=2

# ── 浏览器自动化（可选，默认关闭）────────────────────────
# 开启前请知悉：调试端口能读取页面内容与 Cookie，等同高权限通道。
BROWSER_ENABLED=false
# 只允许回环地址，指向外部主机会被拒绝。
BROWSER_CDP_URL=http://127.0.0.1:9222
# 域名白名单，逗号分隔。留空 = 拒绝全部站点。例：example.com,docs.internal
BROWSER_ALLOWED_HOSTS=
BROWSER_MAX_STEPS=12
BROWSER_TIMEOUT_MS=30000
# 启动浏览器示例（Chrome 136+ 必须指定独立用户目录，否则调试端口不生效）：
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="E:\chrome-automation"
# 注意：独立目录是全新 profile，不会复用日常浏览器的登录态，首次需在其中登录目标站点。

# ── 智能体执行预算与规划层 ──────────────────────────────
# 硬上限：防失控循环。智能体定义里的步数只能在此之内取值。
AGENT_MAX_STEPS=24
# 未指定时的默认步数（默认智能体与新建智能体都用它）。
AGENT_DEFAULT_STEPS=8
# 规划层：先出计划再执行。关掉即退回单段工具循环。
AGENT_PLANNER_ENABLED=true
# 反思层：收尾前审查目标是否真的达成，未达成则续跑。
AGENT_REFLECT_ENABLED=true
# 反思后最多重排几次，防止「反思—重排」自激循环。
AGENT_MAX_REVISIONS=2
# 单次运行墙钟上限（毫秒），超出即收尾交付已有结果。
AGENT_RUN_TIMEOUT_MS=300000

# ── 插件（把外部接口接成智能体工具）──────────────────────
# 插件只做声明式 HTTP 调用，不执行任何代码。凭据加密存储，不交给模型。
PLUGINS_ENABLED=true
# 出站白名单，逗号分隔。**留空 = 拒绝全部地址**（与浏览器同口径）。
# 例：api.example.com,mcp.internal
PLUGINS_ALLOWED_HOSTS=
# 是否允许连本机与内网地址（自建 MCP / 内网服务）。默认 false。
# 开启后**仍要求地址命中上面的白名单**，不是无条件放行。
# 注意：默认拒绝包含 169.254.169.254 等云元数据端点，防止被用来窃取凭据。
PLUGINS_ALLOW_PRIVATE_NETWORKS=false
PLUGINS_TIMEOUT_MS=8000
PLUGINS_MAX_RESPONSE_BYTES=65536
PLUGINS_MAX_PER_WORKSPACE=30
# 单个 MCP 插件最多引入多少远端工具，防止工具清单被远端撑爆。
PLUGINS_MAX_REMOTE_TOOLS=20
# 远端工具清单缓存时长（毫秒）。0 = 每次都拉取（慢，且远端抖动会让清单忽有忽无）。
PLUGINS_REMOTE_CACHE_MS=300000

# ── 向量索引（大库检索加速）──────────────────────────────
# auto：片段数超阈值且已建索引才走分桶裁剪；scan：强制全扫；index：强制走索引。
VECTOR_INDEX_MODE=auto
# 小库全扫更准更快，超过这个片段数才值得建索引。
VECTOR_INDEX_THRESHOLD=20000
# 桶数上限。实际取 min(此值, ceil(sqrt(片段数)))；显式重建时可指定。
VECTOR_BUCKETS=256
# 查询探查的桶数（nprobe）。越大召回越高越慢；实测 nprobe=6 在 2000 片段上 recall@10=1.0。
VECTOR_PROBES=8
VECTOR_TRAIN_ITERATIONS=12
VECTOR_TRAIN_SAMPLE=4096
# 最大桶/平均桶超过此比例时界面提示重训。
VECTOR_REBALANCE_RATIO=6

# ── 分层记忆 ──────────────────────────────────────────
# 会话短期记忆的保留分钟数，只在当前会话内可见。
MEMORY_WORKING_TTL_MINUTES=120
MEMORY_WORKING_MAX=20
MEMORY_PREFERENCE_MAX=200
MEMORY_SEMANTIC_MAX=300
MEMORY_EPISODIC_MAX=200
# 执行经验层：自动记录客观运行结果（目标/工具/成败），带保留期与来源可回溯。
# **默认关闭**——它是自动写入，需你显式开启。偏好与事实永远只由显式保存产生。
MEMORY_EPISODIC_ENABLED=false
MEMORY_EPISODIC_TTL_DAYS=30
# 单次召回的记忆总条数上限，防止撑爆提示词。
MEMORY_RECALL_TOTAL=8

# ── 数据库 ────────────────────────────────────────────
DATABASE_PATH=.data/mirelth.db
